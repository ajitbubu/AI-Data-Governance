# ──────────────────────────────────────────────────────────────────────────────
# DataSafeguard AI Governance Platform - Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your configuration values

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ──────────────────────────────────────────────────────────────────────────────

# Application name
APP_NAME="DataSafeguard API"

# Application version
APP_VERSION="0.1.0"

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to "false" in production)
DEBUG=false

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# Log format: text or json
LOG_FORMAT=json

# API prefix for routes
API_PREFIX=/api/v1

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://datasafeguard:datasafeguard@postgres:5432/datasafeguard

# Enable SQL echo logging (shows all SQL queries)
DATABASE_ECHO=false

# ──────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Redis connection string
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ──────────────────────────────────────────────────────────────────────────────

# Secret key for JWT signing (generate with: openssl rand -hex 32)
# IMPORTANT: Change this in production!
SECRET_KEY=dev-secret-key-change-in-production-12345

# JWT algorithm (HS256, RS256, etc.)
ALGORITHM=HS256

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Enable bypass authentication for development (set to "false" in production)
AUTH_DEV_BYPASS=false

# ──────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Allowed origins for CORS (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost"]

# ──────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────────────────────────────

# Rate limit per minute for API endpoints
RATE_LIMIT_PER_MINUTE=60

# ──────────────────────────────────────────────────────────────────────────────
# AI CLASSIFICATION SETTINGS
# ──────────────────────────────────────────────────────────────────────────────

# Confidence threshold for AI classification (0.0 - 1.0)
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75

# Similarity threshold for ANNEX III classification (0.0 - 1.0)
ANNEX_III_SIMILARITY_THRESHOLD=0.70

# ──────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY & MONITORING
# ──────────────────────────────────────────────────────────────────────────────

# Enable OpenTelemetry instrumentation
OTEL_ENABLED=false

# OTEL exporter endpoint for Jaeger/OTLP
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Service name for observability
OTEL_SERVICE_NAME=datasafeguard-api

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Frontend public API URL
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# ──────────────────────────────────────────────────────────────────────────────
# GUNICORN CONFIGURATION (Production)
# ──────────────────────────────────────────────────────────────────────────────

# Number of Gunicorn worker processes
WORKERS=4

# ──────────────────────────────────────────────────────────────────────────────
# NOTES
# ──────────────────────────────────────────────────────────────────────────────
# - In production, generate a strong SECRET_KEY: openssl rand -hex 32
# - Use environment-specific .env files for different deployments
# - Never commit .env to version control (use .env.example instead)
# - All variables are optional unless marked as REQUIRED
# - Docker Compose will override these with service environment variables
